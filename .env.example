# Copy to .env. All values below are synthetic development defaults.
SENTINEL_ENV=development
SENTINEL_API_URL=http://localhost:8000
SENTINEL_WEB_URL=http://localhost:3000
SENTINEL_GATEWAY_URL=http://localhost:8080
SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:sentinel_dev_only@postgres:5432/sentinel
SENTINEL_REDIS_URL=redis://redis:6379/0
SENTINEL_S3_ENDPOINT=http://minio:9000
SENTINEL_S3_BUCKET=sentinel-artifacts
SENTINEL_S3_ACCESS_KEY=sentinel
SENTINEL_S3_SECRET_KEY=sentinel_dev_only
SENTINEL_SESSION_SECRET=replace-with-at-least-32-random-characters
SENTINEL_CREDENTIAL_KEY=replace-with-a-fernet-key-in-production
SENTINEL_SIGNING_KEY_PATH=/data/signing-key.pem
SENTINEL_COOKIE_SECURE=false
SENTINEL_ALLOW_REGISTRATION=false
SENTINEL_RAW_PAYLOAD_RETENTION_DAYS=7
SENTINEL_MAX_PAYLOAD_BYTES=1048576
SENTINEL_GATEWAY_API_TOKEN=dev-gateway-token-change-me
NEXT_PUBLIC_API_PREFIX=/api/v1
